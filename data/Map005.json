{"id":1,"name":"OpeningScene","note":"\\n<x>\\c[0]","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":241,"indent":0,"parameters":[{"name":"another beast","volume":25,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[180]},{"code":211,"indent":0,"parameters":[0]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["After long hours and restless nights, today is finally "]},{"code":401,"indent":0,"parameters":["the day."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["I've officially been promoted at Super Cheap Auto."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["I've wanted nothing more than to be promoted to a higher "]},{"code":401,"indent":0,"parameters":["position at the greatest mechanical retail store in the "]},{"code":401,"indent":0,"parameters":["country."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["There's just one slight issue."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["One of my closest friends of over 5 years has some...\\| "]},{"code":401,"indent":0,"parameters":["unsavoury screenshots of things I have said, "]},{"code":401,"indent":0,"parameters":["and recently his computer was compromised."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["He reassures me that none of the images could have gone "]},{"code":401,"indent":0,"parameters":["public...\\| but I can't leave it to chance.\\| Besides, "]},{"code":401,"indent":0,"parameters":["what if it happens again?"]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["Luckily, I know someone who can help with this exact "]},{"code":401,"indent":0,"parameters":["issue."]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\fi*bzzt* *bzzt*\\fi"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>Hey Brendan, how you been?"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>Good, good.\\| I'll be honest man, I'm in a tight "]},{"code":401,"indent":0,"parameters":["spot right now."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>Our good friend Mal has some screenshots of old "]},{"code":401,"indent":0,"parameters":["conversations between him and I that need to be deleted."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>You...\\| think you can handle that?"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>Yeah, He'll probably be mad, but I know he'll get over it."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>Let's talk it over more at your place."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>Mhm.\\| See you soon."]},{"code":221,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[1,"Room",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[15]},{"code":250,"indent":0,"parameters":[{"name":"Open5","volume":20,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[120]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>You got any ideas?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>I thought about it for some time and I'm not "]},{"code":401,"indent":0,"parameters":["too sure.\\| He told me about how he recently got hacked and "]},{"code":401,"indent":0,"parameters":["bought this super expensive anti-virus, so I don't exactly "]},{"code":401,"indent":0,"parameters":["know how I'm supposed to get passed that."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>Can't you like...\\| do some hacking wizard shit?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>You know it's not that easy!"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>Okay, chill!\\. I was kidding!"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>So what can we do then?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>Let me think..."]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Brendan slumps into his computer chair and stares blankly "]},{"code":401,"indent":0,"parameters":["into his monitor."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Then he looks down at his desk and towards a suspicious "]},{"code":401,"indent":0,"parameters":["pile of cables."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>What\\fi is\\fi that?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>It's...\\| something I've been working on. It's "]},{"code":401,"indent":0,"parameters":["not important right now."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>What does it do?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>Well...\\| It's for a company I've been working "]},{"code":401,"indent":0,"parameters":["for recently.\\| We're testing a prototype for \"digitalised consciousness\"."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>Huh."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Brendan's eyes widen as an idea has clearly entered his mind."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>The company has this internal forum we can post to, "]},{"code":401,"indent":0,"parameters":["and recently someone mentioned the DCs-\\. I mean-\\. "]},{"code":401,"indent":0,"parameters":["digitised consciousnesses weren't being picked up by\\fi any\\fi "]},{"code":401,"indent":0,"parameters":["anti-viruses."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>No.\\. No fucking way."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>I'm gonna be honest man, It's our best shot."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>That's insane!"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>I've tested it like a hundred times now.\\. You're "]},{"code":401,"indent":0,"parameters":["gonna be okay."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>..."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>Fuck it. Let's just do it."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>Okay sick.\\. I'll boot up the DCIE, "]},{"code":401,"indent":0,"parameters":["package the program and send it to Mal over discord.\\. I can "]},{"code":401,"indent":0,"parameters":["communicate with you the whole time and it'll sound like I'm a voice in your head."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>And you just...\\| have all this?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>Technically, I'm not supposed to tell you about "]},{"code":401,"indent":0,"parameters":["any of this or even show you..."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>Still,\\. this is all so surreal to me."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>That' how I felt the first 10 or so times I "]},{"code":401,"indent":0,"parameters":["used it..."]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>Okay!\\. Program is up and waiting."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Brendan gets out of his chair and ushers me to the seat eagerly."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Shawn>If this somehow kills me, I'm going to haunt you "]},{"code":401,"indent":0,"parameters":["for the rest of your life."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I nervously take a seat."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>Ha!\\. You'll be fine man."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Brendan hands me what looks to be an old and now repurposed "]},{"code":401,"indent":0,"parameters":["VR headset.\\| With shakey hands, I put it on."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Brendan>Running program now. Whatever you do, don't close "]},{"code":401,"indent":0,"parameters":["your eyes.\\. No matter how much you want to."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["As soon as he says this, a near seizure inducing amount of "]},{"code":401,"indent":0,"parameters":["flashing lights assault my eyes, alongside the most teeth "]},{"code":401,"indent":0,"parameters":["clenching, ear drum bursting sound I've ever heard."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["I feel the uncontrollable urge to scream, but when I try to "]},{"code":401,"indent":0,"parameters":["no sound comes out.\\| I can feel my heart pounding in my chest "]},{"code":401,"indent":0,"parameters":["as the gravity of the situation hits me like a truck."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Despite never having a near death experience, It feels like "]},{"code":401,"indent":0,"parameters":["I've experience a thousand of them in a second, the screaching "]},{"code":401,"indent":0,"parameters":["sound etching itself into every milimeter of my skull."]},{"code":235,"indent":0,"parameters":[1]},{"code":242,"indent":0,"parameters":[1]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Then...\\| Nothing..."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["The lights, the screaching...\\| All ended...\\| in an instant."]},{"code":230,"indent":0,"parameters":[120]},{"code":231,"indent":0,"parameters":[2,"Shawnstuck_1080",1,0,960,528,80,80,255,0]},{"code":250,"indent":0,"parameters":[{"name":"titleblare","volume":50,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[300]},{"code":232,"indent":0,"parameters":[2,0,1,0,960,528,80,80,0,0,120,true]},{"code":230,"indent":0,"parameters":[180]},{"code":201,"indent":0,"parameters":[0,4,4,35,8,0]},{"code":0,"indent":0,"parameters":[]}],"mo